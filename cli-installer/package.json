{
  "name": "agentic-sdlc-method",
  "version": "3.0.1",
  "description": "Installer for The Agentic SDLC Method: 23 AI skills (a router, 13 agents and 19 stage skills from Discover to Operate, with human sign-offs and evidence-based verification) for Claude Code, GitHub Copilot and 6 more AI tools",
  "bin": {
    "agentic-sdlc-method": "bin/cli.js"
  },
  "scripts": {
    "test": "node --check bin/cli.js && node bin/cli.js --version",
    "build": "cd .. && ./scripts/build-skills.sh",
    "prebuild": "cd .. && ./scripts/build-skills.sh",
    "link": "npm link",
    "unlink": "npm unlink -g agentic-sdlc-method",
    "generate-index": "cd .. && python3 scripts/generate-skills-index.py",
    "generate-catalog": "cd .. && python3 scripts/generate-catalog.py",
    "generate-all": "npm run build && npm run generate-index && npm run generate-catalog",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "cp ../bundles.json ./bundles.json",
    "version": "git add -A"
  },
  "keywords": [
    "copilot",
    "claude",
    "codex",
    "ai",
    "skills",
    "cli",
    "prompt-engineering",
    "github-copilot",
    "claude-code",
    "openai-codex",
    "agentic-sdlc",
    "sdlc",
    "spec-driven-development",
    "tdd",
    "code-review"
  ],
  "author": "Eric Andrade",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "bundles.json"
  ],
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.6.5",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.5",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "semver": "^7.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericgandrade/agentic-sdlc.git"
  },
  "bugs": {
    "url": "https://github.com/ericgandrade/agentic-sdlc/issues"
  },
  "homepage": "https://github.com/ericgandrade/agentic-sdlc#readme"
}
