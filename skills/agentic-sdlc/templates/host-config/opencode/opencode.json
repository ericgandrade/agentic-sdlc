{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git merge*": "deny",
      "git tag*": "deny",
      "gh pr merge*": "deny",
      "npm publish*": "deny",
      "*--force*": "deny"
    }
  },
  "agent": {
    "reviewer": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git push*": "deny"
        }
      }
    }
  }
}
