{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.agentic-sdlc/bin/guard.mjs pre-tool --host claude-code",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.agentic-sdlc/bin/guard.mjs human-turn --host claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
